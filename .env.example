# Host-process development defaults. Docker Compose overrides database and
# service URLs with Compose-network names while keeping browser URLs localhost.
DATABASE_URL=postgres://charge:charge@localhost:5432/charge_station
JWT_SECRET=development-jwt-secret-change-me
ADMIN_EMAIL=admin@charge.local
ADMIN_PASSWORD=local-admin-password-change-me
# AES-256-GCM key for encrypted station QR URLs. Use a unique 32-byte hex key
# in every deployed environment.
STATION_QR_ENCRYPTION_KEY=4d8eae9b3271c5f079cfb8b4f14ba3ca9d7e6a0b4c32f807c2d2ab5e983f1140
FRONTEND_URL=http://localhost:3100

# IoT Nano credentials are supplied by the tenant-cs seed. Do not commit real
# values. Compose maps the API and MQTT host to host.docker.internal.
IOT_NANO_API_URL=http://127.0.0.1:18081
IOT_NANO_PAT=<tenant-cs-personal-access-token>
IOT_NANO_DEVICE_ID=<tenant-cs-device-id>
IOT_NANO_RELAY_ID=relay-1
IOT_NANO_COMMAND_TIMEOUT_MS=10000
IOT_NANO_COMMAND_POLL_MS=250
IOT_NANO_TELEMETRY_POLL_MS=2000
IOT_NANO_TELEMETRY_STALE_MS=15000
IOT_NANO_MQTT_HOST=127.0.0.1
IOT_NANO_MQTT_PORT=18883
IOT_NANO_DEVICE_TOKEN=<tenant-cs-device-token>
IOT_SIMULATOR_TELEMETRY_INTERVAL_SECONDS=1

# Local Compose and host development use the in-process PayOS mock. It never
# calls PayOS. Live values and public callback requirements are documented in
# docs/local-development.md.
PAYOS_MODE=mock
PAYOS_CLIENT_ID=local-client-id
PAYOS_API_KEY=local-api-key
PAYOS_CHECKSUM_KEY=local-checksum-key
PAYOS_MOCK_CHECKOUT_BASE_URL=http://localhost:4000
PAYOS_RETURN_URL=http://localhost:4000/payments/payos/return
PAYOS_CANCEL_URL=http://localhost:4000/payments/payos/cancel
PAYMENT_RESERVATION_TTL_MINUTES=15
PAYMENT_REAPER_INTERVAL_MS=60000

# Used when running the Next.js app directly on the host.
NEXT_PUBLIC_API_URL=http://localhost:4000
